# 复制为 .env 后填写（.env 不要提交到 git）

# Anthropic: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# 可选：默认 claude-opus-5-5；想更省钱可改成 claude-haiku-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Microsoft: Azure portal → App registrations 里的 Application (client) ID
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# 个人邮箱(outlook.com/hotmail) 用 consumers；学校/公司邮箱用 organizations
MS_AUTHORITY=consumers
OUTLOOK_FOLDER=Application

# Notion: https://www.notion.so/profile/integrations → Internal integration secret
NOTION_TOKEN=ntn_...
# 数据库 URL 里 notion.so/xxx/<这32位>?v=... 的那段
NOTION_DATABASE_ID=
